<?xml version="1.0"?>
<routes xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Webapi:etc/webapi.xsd">
    <route url="/V1/izi/basket_information/:cartId" method="POST">
        <service class="InPost\InPostPay\Api\WidgetInterface" method="getPayData" />
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>
    <route url="/v1/izi/basket/:basketId" method="GET">
        <service class="InPost\InPostPay\Api\ApiConnector\Merchant\BasketInterface" method="get"/>
        <resources>
            <resource ref="inpost_pay_signature_validated_resource" />
        </resources>
    </route>
    <route url="/v1/izi/basket/:basketId/event" method="POST">
        <service class="InPost\InPostPay\Api\ApiConnector\Merchant\BasketInterface" method="update"/>
        <resources>
            <resource ref="inpost_pay_signature_validated_resource" />
        </resources>
    </route>
    <route url="/v1/izi/basket/:basketId/binding" method="DELETE">
        <service class="InPost\InPostPay\Api\ApiConnector\Merchant\BasketInterface" method="delete"/>
        <resources>
            <resource ref="inpost_pay_signature_validated_resource" />
        </resources>
    </route>
    <route url="/v1/izi/basket/:basketId/confirmation" method="POST">
        <service class="InPost\InPostPay\Api\ApiConnector\Merchant\BasketConfirmationInterface" method="execute"/>
        <resources>
            <resource ref="inpost_pay_signature_validated_resource" />
        </resources>
    </route>

    <!-- Managing InPost Basket guest confirmation -->
    <route url="/V1/inpost-basket/:cartId/confirmation" method="POST">
        <service class="InPost\InPostPay\Api\Widget\Basket\GetGuestConfirmationInterface" method="execute"/>
        <resources>
            <resource ref="anonymous" />
        </resources>
    </route>

    <!-- Managing InPost Basket guest confirmation -->
    <route url="/V1/inpost-basket/mine/confirmation" method="POST">
        <service class="InPost\InPostPay\Api\Widget\Basket\GetConfirmationInterface" method="execute"/>
        <resources>
            <resource ref="self" />
        </resources>
        <data>
            <parameter name="cartId" force="true">%cart_id%</parameter>
        </data>
    </route>
</routes>
