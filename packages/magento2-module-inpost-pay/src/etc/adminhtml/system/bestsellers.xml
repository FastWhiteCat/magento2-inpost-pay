<?xml version="1.0"?>
<include xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_include.xsd">
    <group id="bestsellers" translate="label" type="text" sortOrder="100" showInDefault="1">
        <label>InPost Pay Bestsellers Settings</label>
        <frontend_model>Magento\Config\Block\System\Config\Form\Fieldset</frontend_model>
        <field id="bestsellers_synchronize_enabled" translate="label" type="select" sortOrder="1"
               showInDefault="1" canRestore="1">
            <label>Enabled Bestsellers Synchronization</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>payment/inpost_pay/bestsellers_synchronize_enabled</config_path>
            <comment>When enabled any save of selected bestseller product or inventory will trigger update of Bestseller Product. Also, any reservation append will check if configured Bestseller Product is still saleable, if not update will be performed.</comment>
        </field>
        <field id="bestsellers_synchronize_cron_enabled" translate="label" type="select" sortOrder="10"
               showInDefault="1" canRestore="1">
            <label>Enabled Bestsellers Synchronize CRON</label>
            <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
            <config_path>payment/inpost_pay/bestsellers_synchronize_cron_enabled</config_path>
            <comment>When enabled scheduled CRON Job will synchronize Magento Bestsellers into InPost Pay API.</comment>
        </field>
        <field id="bestsellers_synchronize_mode" translate="label" type="select" sortOrder="10"
               showInDefault="1" canRestore="1">
            <label>Synchronization Mode</label>
            <source_model>InPost\InPostPay\Model\Config\Source\BestsellersSynchronizeMode</source_model>
            <config_path>payment/inpost_pay/bestsellers_synchronize_mode</config_path>
            <comment>Configuration allows to choose if Magento Bestsellers Configuration should be uploaded to InPost Pay or downloaded from InPost Pay API.</comment>
            <depends>
                <field id="bestsellers_synchronize_cron_enabled">1</field>
            </depends>
        </field>
        <field id="bestsellers_synchronize_cron_schedule" translate="label" type="text" sortOrder="20" showInDefault="1" canRestore="1">
            <label>Synchronize Bestsellers Cron Schedule</label>
            <comment>30 6 * * * for example causes this CRON to run every day, at 6:30 AM</comment>
            <config_path>payment/inpost_pay/bestsellers_synchronize_cron_schedule</config_path>
            <depends>
                <field id="bestsellers_synchronize_cron_enabled">1</field>
            </depends>
        </field>
    </group>
</include>
