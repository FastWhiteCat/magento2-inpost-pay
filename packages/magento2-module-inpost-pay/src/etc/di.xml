<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:ObjectManager/etc/config.xsd">
    <preference for="InPost\InPostPay\Api\Data\InPostPayOrderInterface"
                type="InPost\InPostPay\Model\InPostPayOrder"/>
    <preference for="InPost\InPostPay\Api\Data\InPostPayQuoteInterface"
                type="InPost\InPostPay\Model\InPostPayQuote"/>
    <preference for="InPost\InPostPay\Api\InPostPayOrderRepositoryInterface"
                type="InPost\InPostPay\Model\InPostPayOrderRepository"/>
    <preference for="InPost\InPostPay\Api\OrderLockerServiceInterface"
                type="InPost\InPostPay\Service\Order\OrderLockerService"/>
    <preference for="InPost\InPostPay\Api\Validator\SignatureValidatorInterface"
                type="InPost\InPostPay\Validator\SignatureValidator"/>
    <preference for="InPost\InPostPay\Api\ApiConnector\ConnectorInterface"
                type="InPost\InPostPay\Service\ApiConnector\Connector"/>
    <preference for="InPost\InPostPay\Api\InPostPayLockerIdProviderInterface"
                type="InPost\InPostPay\Provider\InPostPayLockerIdProvider" />
    <preference for="InPost\InPostPay\Api\ApiConnector\Merchant\BasketEventInterface"
                type="InPost\InPostPay\Service\ApiConnector\Merchant\BasketEvent"/>
    <preference for="InPost\InPostPay\Api\InPostPayQuoteRepositoryInterface"
                type="InPost\InPostPay\Model\InPostPayQuoteRepository"/>
    <preference for="InPost\InPostPay\Api\CheckoutAgreementsVersionRepositoryInterface"
                type="InPost\InPostPay\Model\CheckoutAgreementsVersionRepository" />
    <type name="Magento\CheckoutAgreements\Api\CheckoutAgreementsRepositoryInterface">
        <plugin name="update_checkout_agreement_version"
                type="InPost\InPostPay\Plugin\CheckoutAgreementsRepository\UpdateCheckoutAgreementsVersionPlugin" />
    </type>
    <type name="Magento\CheckoutAgreements\Api\Data\AgreementInterface">
        <plugin name="InPost_InPostPay::updateCheckoutAgreementsVersionPlugin"
                type="InPost\InPostPay\Plugin\UpdateCheckoutAgreementsVersionPlugin" />
    </type>
    <type name="Magento\Quote\Api\ChangeQuoteControlInterface">
        <plugin name="InPost_InPostPay::allowRemoteQuoteChangeByInPostPayPlugin"
                type="InPost\InPostPay\Plugin\Quote\AllowRemoteQuoteChangeByInPostPayPlugin" />
    </type>
    <virtualType name="InPostPayPaymentFacade" type="Magento\Payment\Model\Method\Adapter">
        <arguments>
            <argument name="code" xsi:type="string">inpost_pay</argument>
            <argument name="formBlockType" xsi:type="string">Magento\Payment\Block\Form</argument>
            <argument name="infoBlockType" xsi:type="string">Magento\Payment\Block\Info</argument>
            <argument name="valueHandlerPool" xsi:type="object">InPostPayPaymentValueHandlerPool</argument>
            <argument name="commandPool" xsi:type="object">InPostPayPaymentCommandPool</argument>
        </arguments>
    </virtualType>
    <virtualType name="InPostPayPaymentValueHandlerPool" type="Magento\Payment\Gateway\Config\ValueHandlerPool">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="default" xsi:type="string">InPostPayPaymentConfigValueHandler</item>
            </argument>
        </arguments>
    </virtualType>
    <virtualType name="InPostPayPaymentConfigValueHandler" type="Magento\Payment\Gateway\Config\ConfigValueHandler">
        <arguments>
            <argument name="configInterface" xsi:type="object">InPostPayPaymentConfig</argument>
        </arguments>
    </virtualType>
    <virtualType name="InPostPayPaymentConfig" type="Magento\Payment\Gateway\Config\Config">
        <arguments>
            <argument name="methodCode" xsi:type="string">inpost_pay</argument>
        </arguments>
    </virtualType>
    <virtualType name="InPostPayPaymentCommandPool" type="Magento\Payment\Gateway\Command\CommandPool">
        <arguments>
            <argument name="commands" xsi:type="array">
                <item name="capture" xsi:type="string">Magento\Payment\Gateway\Command\NullCommand</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="InPost\InPostPay\Service\Converter\QuoteToBasketDataConverter">
        <arguments>
            <argument name="converters" xsi:type="array">
                <item name="summary" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketSummaryDataConverter</item>
                <item name="delivery" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketDeliveryDataConverter</item>
                <item name="promo_codes" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketPromoCodesDataConverter</item>
                <item name="products" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketProductsDataConverter</item>
                <item name="related_products" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketRelatedProductsDataConverter</item>
                <item name="consents" xsi:type="object">InPost\InPostPay\Service\Converter\QuoteToBasket\QuoteToBasketConsentsDataConverter</item>
            </argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Logger\Handler">
        <arguments>
            <argument name="debugConfigProvider" xsi:type="object">InPost\InPostPay\Provider\Config\DebugConfigProvider</argument>
        </arguments>
    </type>
    <virtualType name="InPost\InPostPay\Logger\InPostPayLogger" type="Magento\Framework\Logger\Monolog">
        <arguments>
            <argument name="handlers" xsi:type="array">
                <item name="debug" xsi:type="object">InPost\InPostPay\Logger\Handler</item>
            </argument>
        </arguments>
    </virtualType>
    <type name="InPost\InPostPay\Service\ApiConnector\Connector">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Service\ApiConnector\TokenGenerator">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Service\ApiConnector\PublicKeyGenerator">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Validator\SignatureValidator">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Provider\InPostPayLockerIdProvider">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Block\Adminhtml\Order\OrderViewDeliveryInfo">
        <arguments>
            <argument name="inPostPayAdapter" xsi:type="object">InPostPayPaymentFacade</argument>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Plugin\Adminhtml\Order\View\RegisterCurrentOrderPlugin">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Service\Order\OrderLockerService">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Service\Converter\QuoteToBasketDataConverter">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Provider\DeliveryDateProvider">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Observer\Quote\UpdateInPostBasketEventObserver">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type><type name="InPost\InPostPay\Service\Cart\CartService">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
    <type name="InPost\InPostPay\Service\ApiConnector\Merchant\BasketEvent">
        <arguments>
            <argument name="logger" xsi:type="object">InPost\InPostPay\Logger\InPostPayLogger</argument>
        </arguments>
    </type>
</config>
