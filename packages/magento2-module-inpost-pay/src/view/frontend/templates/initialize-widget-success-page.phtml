<?php
/**
 * @var Magento\Framework\View\Element\Template $block
 * @var InPost\InPostPay\ViewModel\Widget $widgetViewModel
 * @var Magento\Framework\Escaper $escaper
 */

$widgetViewModel = $block->getData('widget_view_model');
if (!$widgetViewModel->isEnabled()
    || !$widgetViewModel->isInPostPayOrder()
    || !$widgetViewModel->isEnabledOnSuccessPage()) {
    return;
}
$merchantClientId = $widgetViewModel->getClientMerchantId();
$language = $widgetViewModel->getCurrentLanguageCode();
$enabledAnalyticsParams = $widgetViewModel->isAnalyticsEnabled();
$widgetWrapperClass = "inpay-widget-wrapper";
$bindingPlace = $block->getBindingPlace();
$scriptUrl = $widgetViewModel->getScriptUrl($bindingPlace);
?>

<div class="<?= $escaper->escapeHtmlAttr($widgetWrapperClass . ' ' . $bindingPlace)?>">
    <inpost-thank-you/>

    <script type="text/x-magento-init">
        {
            "*" : {
                "InpostPayMerchantWidget" : {
                    "bindingPlace": "<?= $escaper->escapeJs($bindingPlace) ?>",
                    "scriptUrl": "<?= $escaper->escapeJs($scriptUrl) ?>",
                    "merchantClientId": "<?= $escaper->escapeJs($merchantClientId) ?>",
                    "language": "<?= $escaper->escapeJs($language) ?>",
                    "enabledAnalyticsParams": "<?= $escaper->escapeJs((string)$enabledAnalyticsParams) ?>"
                }
            }
        }
    </script>
</div>
