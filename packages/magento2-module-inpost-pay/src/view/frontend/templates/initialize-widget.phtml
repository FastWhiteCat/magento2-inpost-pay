<?php

use InPost\InPostPay\Provider\Config\DisplayConfigProvider;

/**
 * @var Magento\Framework\View\Element\Template $block
 * @var InPost\InPostPay\ViewModel\Widget $widgetViewModel
 */

$widgetViewModel = $block->getData('widget_view_model');
$bindingPlace = $block->getBindingPlace();

//TODO - INPAY-11(FE) - Provide a parameter e.g. isInPostCartPaired, if carts (magento and inpay) are paired
// MOCK
$isInPostCartPaired = false;
$clientName = "John";
$clientPhoneNumber = "123123123";
$name = $isInPostCartPaired ? $clientName : "";
$maskedPhoneNumber = $isInPostCartPaired ? $clientPhoneNumber : "";
$isProductPage = $widgetViewModel->isEnabledOnProductCart() &&
    $bindingPlace === DisplayConfigProvider::PRODUCT_CARD_BINDING_PLACE_NAME;
$isCartPage = $widgetViewModel->isEnabledOnCart() &&
    $bindingPlace === DisplayConfigProvider::BASKET_SUMMARY_BINDING_PLACE_NAME;
$productId = $isProductPage ? $block->getRequest()->getParam('id') : "";
$language = $widgetViewModel->getCurrentLanguageCode();
$cartItemsCount = $widgetViewModel->getCartItemsCount();
$layoutConfig = $widgetViewModel->getLayoutConfig();
$cartId = $block->getQuoteId();
?>

<?php if ($bindingPlace === DisplayConfigProvider::THANK_YOU_PAGE_BINDING_PLACE_NAME): ?>
    <inpost-thank-you/>
<?php else: ?>
    <inpost-izi-button
        name="<?= /* @noEscape */ $name ?>"
        masked_phone_number="<?= /* @noEscape */ $maskedPhoneNumber ?>"
        data-product-id="<?= /* @noEscape */ $productId ?>"
        language="<?= /* @noEscape */ $language ?>"
        variant="<?= /* @noEscape */ $layoutConfig['variant'] ?>"
        basket="<?= /* @noEscape */ $isCartPage ? 'true' : 'false' ?>"
        dark_mode="<?= /* @noEscape */ $layoutConfig['darkMode'] ?>"
        count="<?= /* @noEscape */ $cartItemsCount ?>"
        binding_place="<?= /* @noEscape */ $bindingPlace ?>">
    </inpost-izi-button>

    <script type="text/x-magento-init">
        {
            "*" : {
                "InpostPayMerchantWidget" : {
                    "cartId": "<?= $cartId ?>"
                }
            }
        }
    </script>
<?php endif;
