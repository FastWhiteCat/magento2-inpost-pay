<?xml version="1.0"?>
<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceBlock name="after.body.start">
            <block class="InPost\InPostPay\Block\Script" name="inpost.init.script.product"
                   template="InPost_InPostPay::initialize-script.phtml"
                   ifconfig="payment/inpost_pay/show_on_product_cart">
                <arguments>
                    <argument name="binding_place" xsi:type="string">PRODUCT_CARD</argument>
                </arguments>
            </block>
        </referenceBlock>
        <referenceBlock name="product.info.options.wrapper.bottom">
            <block class="InPost\InPostPay\Block\Widget" name="inpost.init.widget.product"
                   template="InPost_InPostPay::initialize-widget.phtml"
                   after="-" ifconfig="payment/inpost_pay/show_on_product_cart">
                <arguments>
                    <argument name="binding_place" xsi:type="string">PRODUCT_CARD</argument>
                </arguments>
            </block>
        </referenceBlock>
    </body>
</page>
