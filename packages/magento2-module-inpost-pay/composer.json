    "version": "2.3.1",
    "type": "magento2-module",
    "license": ["CC-BY-NC-ND-4.0"],
    "require": {
        "php": ">=8.1",
        "laminas/laminas-http": "*",
        "monolog/monolog": "*",
        "psr/log": "*",
        "guzzlehttp/guzzle": "*",
        "inpost/magento2-module-restrictions": ">=2.3.0"
    },
    "autoload": {
